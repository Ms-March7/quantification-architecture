{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qdata-local-download-build-v1",
  "title": "Local downloaded dataset candidate request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mode",
    "dataset_id",
    "run_id",
    "source_id",
    "dataset_schema_version",
    "authorized_local_research_download",
    "source_access_note",
    "table"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "mode": {
      "const": "local_download_candidate"
    },
    "dataset_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._=-]{0,127}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._=-]{0,127}$"
    },
    "source_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._=-]{0,127}$"
    },
    "dataset_schema_version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._=-]{0,127}$"
    },
    "authorized_local_research_download": {
      "type": "boolean"
    },
    "source_access_note": {
      "type": "string",
      "minLength": 1
    },
    "include_patterns": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "zip_member_patterns": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "table": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "table_name",
        "expected_columns",
        "column_types",
        "date_column",
        "key_columns",
        "required_columns"
      ],
      "properties": {
        "table_name": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,62}$"
        },
        "expected_columns": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "column_types": {
          "type": "object"
        },
        "date_column": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "key_columns": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "required_columns": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "delimiter": {
          "enum": [
            ",",
            "\t",
            ";",
            "|"
          ]
        },
        "encoding": {
          "enum": [
            "utf-8-sig",
            "utf-8",
            "gb18030",
            "utf-16"
          ]
        },
        "allow_extra_columns": {
          "type": "boolean"
        },
        "partition_mode": {
          "enum": [
            "year_month",
            "single"
          ]
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_packages": {
          "type": "integer",
          "minimum": 1
        },
        "max_csv_sources": {
          "type": "integer",
          "minimum": 1
        },
        "max_archive_members": {
          "type": "integer",
          "minimum": 1
        },
        "max_total_input_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "max_total_unpacked_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "max_compression_ratio": {
          "type": "integer",
          "minimum": 1
        },
        "max_rows": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
