{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quantification.local/contracts/local_daily_orchestration_v1/request.schema.json",
  "title": "Inspection-only local daily orchestration state request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mode",
    "purpose_ceiling",
    "dataset_scope",
    "job_id",
    "dataset_id",
    "source_id",
    "timezone",
    "calendar_dates",
    "max_attempts",
    "lease_seconds",
    "authorization_note"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "mode": {
      "const": "local_daily_orchestration_state"
    },
    "purpose_ceiling": {
      "const": "INSPECTION_ONLY"
    },
    "dataset_scope": {
      "enum": [
        "synthetic_fixture",
        "registered_inspection"
      ]
    },
    "job_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "dataset_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "source_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "timezone": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "calendar_dates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4000,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "date"
      }
    },
    "max_attempts": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "lease_seconds": {
      "type": "integer",
      "minimum": 30,
      "maximum": 86400
    },
    "authorization_note": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    }
  }
}
