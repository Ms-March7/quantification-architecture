{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qdata-schema-evolution-v1",
  "title": "Inspection-only versioned dataset schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_contract_version",
    "dataset_id",
    "schema_version",
    "dataset_coverage_start",
    "primary_key",
    "fields"
  ],
  "properties": {
    "schema_contract_version": {
      "const": 1
    },
    "dataset_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._=-]{0,127}$"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+(?:\\.[0-9]+){0,2}(?:[-+][A-Za-z0-9.-]+)?$"
    },
    "dataset_coverage_start": {
      "type": "string",
      "format": "date"
    },
    "primary_key": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$"
      }
    },
    "fields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "logical_type",
          "nullable",
          "field_coverage_start"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$"
          },
          "logical_type": {
            "enum": [
              "VARCHAR",
              "DATE",
              "TIMESTAMP_TZ",
              "DOUBLE",
              "BIGINT",
              "BOOLEAN"
            ]
          },
          "nullable": {
            "type": "boolean"
          },
          "field_coverage_start": {
            "type": "string",
            "format": "date"
          }
        }
      }
    }
  }
}
