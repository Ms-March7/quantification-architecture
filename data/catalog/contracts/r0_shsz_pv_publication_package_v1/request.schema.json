{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.quantification/schemas/r0-shsz-pv-publication-package-request-v1.json",
  "title": "R0_SHSZ_PV v2 publication package request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_id",
    "package_id",
    "candidate_manifest",
    "r0_contract",
    "rights_basis_bindings",
    "education_license_observation",
    "user_authorization",
    "publication_timestamps"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "contract_id": {"const": "r0_shsz_pv_publication_package_request_v1"},
    "package_id": {"$ref": "#/$defs/component"},
    "candidate_manifest": {"$ref": "#/$defs/fileBinding"},
    "r0_contract": {"$ref": "#/$defs/fileBinding"},
    "rights_basis_bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "csmar_rights_receipt",
        "csmar_rights_verification",
        "rqdata_quota_receipt"
      ],
      "properties": {
        "csmar_rights_receipt": {"$ref": "#/$defs/fileBinding"},
        "csmar_rights_verification": {"$ref": "#/$defs/fileBinding"},
        "rqdata_quota_receipt": {"$ref": "#/$defs/fileBinding"}
      }
    },
    "education_license_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "license_type",
        "valid_until",
        "observation_source",
        "independent_verification",
        "credential_value_captured"
      ],
      "properties": {
        "license_type": {"const": "EDUCATION"},
        "valid_until": {"const": "2028-08-31"},
        "observation_source": {"const": "USER_PROVIDED_SCREENSHOT_AND_BOUNDED_QUOTA_RECEIPT"},
        "independent_verification": {"const": false},
        "credential_value_captured": {"const": false}
      }
    },
    "user_authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorization_id",
        "recorded_at_utc",
        "statement",
        "source_thread_id",
        "r0_completion_authorized",
        "credential_value_captured"
      ],
      "properties": {
        "authorization_id": {"$ref": "#/$defs/component"},
        "recorded_at_utc": {"type": "string"},
        "statement": {"type": "string"},
        "source_thread_id": {"$ref": "#/$defs/component"},
        "r0_completion_authorized": {"const": true},
        "credential_value_captured": {"const": false}
      }
    },
    "publication_timestamps": {
      "type": "object",
      "additionalProperties": false,
      "required": ["available_at", "intended_published_at"],
      "properties": {
        "available_at": {"type": "string"},
        "intended_published_at": {"type": "string"}
      }
    }
  },
  "$defs": {
    "component": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._=-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "fileBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relative_path", "sha256", "bytes"],
      "properties": {
        "relative_path": {"type": "string"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 1}
      }
    }
  }
}
