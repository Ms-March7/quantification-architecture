{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.quantification/schemas/formal-atomic-publish-prepared-execution-receipt-v1.json",
  "title": "Prepared formal atomic publication execution receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_id",
    "execution_id",
    "status",
    "state",
    "execution_contract_ready",
    "executable",
    "write_performed",
    "formal_effect",
    "network_used",
    "request",
    "preflight",
    "catalog_before",
    "target",
    "payload_layout",
    "candidate_artifact_count",
    "candidate_artifact_bytes",
    "state_machine",
    "execution_plan_sha256",
    "blocking_gaps",
    "boundary"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "contract_id": {"const": "formal_atomic_publish_execution_v1"},
    "execution_id": {"type": "string"},
    "status": {"const": "PASS__READY_FOR_ATOMIC_COMMIT__NO_WRITE"},
    "state": {"const": "INPUT_INVENTORY_SEALED"},
    "execution_contract_ready": {"const": true},
    "executable": {"const": false},
    "write_performed": {"const": false},
    "formal_effect": {"const": "NONE"},
    "network_used": {"const": false},
    "request": {"type": "object"},
    "preflight": {"type": "object"},
    "catalog_before": {"type": "object"},
    "target": {"type": "object"},
    "payload_layout": {"type": "array", "minItems": 2},
    "candidate_artifact_count": {"type": "integer", "minimum": 2},
    "candidate_artifact_bytes": {"type": "integer", "minimum": 2},
    "state_machine": {"type": "object"},
    "execution_plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "blocking_gaps": {"type": "array"},
    "boundary": {"type": "string"}
  }
}
